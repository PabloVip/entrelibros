# Variables de entorno de n8n para Entrelibros (Tarea 2). Copia de ejemplo SIN secretos.
# En Render se ponen en Environment; en local, en un fichero .env que NO se sube al repositorio.

# --- n8n ---
N8N_WEBHOOK_URL=https://entrelibros-n8n.onrender.com/
N8N_PORT=10000
N8N_ENCRYPTION_KEY=cambia-esto-por-una-cadena-aleatoria-larga
GENERIC_TIMEZONE=Europe/Madrid
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Base de datos de n8n (Postgres de Supabase, Session pooler) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-0-eu-west-3.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.<ref-del-proyecto>
DB_POSTGRESDB_PASSWORD=<contraseña-de-la-base-de-datos>
DB_POSTGRESDB_SCHEMA=n8n
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# --- Entrelibros (no secretas) ---
ENTRELIBROS_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
ENTRELIBROS_OPS_CHAT_ID=<id-numérico-del-chat-de-quien-revisa>
ENTRELIBROS_BOT_USERNAME=<usuario_del_bot_sin_arroba>

# --- Credenciales (se crean DENTRO de n8n, no como variables) ---
# «Entrelibros · Supabase (secret key)»  Header Auth  ->  apikey: sb_secret_...
# «Entrelibros · Webhook key»           Header Auth  ->  X-Entrelibros-Key: <secreto compartido>
# «Entrelibros · Telegram bot»          Telegram API ->  token de @BotFather
# «Entrelibros · Gemini»                Google Gemini (PaLM) API -> clave de Google AI Studio
